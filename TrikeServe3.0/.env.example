# Customer ride booking is separate from driver queue joining.
# This Vite setting is read at build time; set it in your web host environment for deployed builds.
VITE_ENABLE_WEB_RIDE_SERVICES=true
VITE_ENABLE_WEB_DRIVER_QUEUE_JOINING=true

# Driver delivery requests are controlled separately from customer food ordering.
VITE_ENABLE_WEB_DRIVER_FOOD_DELIVERY=true
