{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix TrikeServe3.0 ci",
  "buildCommand": "npm --prefix TrikeServe3.0 run build",
  "outputDirectory": "TrikeServe3.0/dist",
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
